{
  "name": "enterprise-risk-assessment-platform",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "setup": "npm install && npm run db:generate -w backend",
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "dev": "concurrently --kill-others \"npm run dev:backend\" \"npm run dev:frontend\"",
    "test": "npm test -w backend && npm test -w frontend",
    "db:generate": "npm run db:generate -w backend",
    "db:migrate": "npm run db:migrate -w backend",
    "db:migrate:prod": "npm run db:migrate:prod -w backend",
    "db:seed": "npm run db:seed -w backend",
    "deploy:backend": "npm run deploy -w backend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
